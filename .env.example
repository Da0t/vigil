# Copy to .env and fill in. Unset vars = local fallback (demo still works).
NEXT_PUBLIC_AGENT_URL=http://localhost:4000
PAYMENTS_URL=http://localhost:4100
GATE_URL=http://localhost:4200
# POMERIUM_URL=http://localhost:4300  # uncomment ONLY when the Pomerium container
                                       # is running (pomerium/README.md). Left unset,
                                       # rollback calls payments-api directly — which
                                       # STILL re-verifies the single-use grant with
                                       # the gate, so the base demo is fully gated.
WORKER_URL=                          # Akash URL from Person C, or http://localhost:4400
ZERO_MODE=fallback                   # "live" once Person C lands Zero
ZERO_API_KEY=
ZERO_API_URL=
ANTHROPIC_API_KEY=                   # optional LLM hypothesis step
